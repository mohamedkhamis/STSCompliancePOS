@model KeyChangeResult
@{ ViewData["Title"] = "KeyChange Result"; }

<div class="breadcrumb">
    <a href="/KeyChange">Key Change</a>
    <span>›</span>
    <span>Result</span>
</div>

<div class="page-header">
    <h2>Keychange Result</h2>
    <div class="subtitle">CTSA05 — Step 2 @(Model.AllMatch ? "PASSED ✓" : "FAILED ✗")</div>
</div>

<div style="text-align: center; margin-bottom: 24px;">
    <div class="success-banner">
        <span>✓ KEYCHANGE VERIFIED — ALL TOKENS MATCH</span>
    </div>
</div>

<div class="grid-2">
    <div>
        <!-- 1st KCT -->
        <div class="card card-accent-green">
            <div class="card-title green">1st Section Decoder Key Token</div>
            <div class="token-label">1st KCT (Set1stSectionDecoderKey)</div>
            <div class="token-display">@Model.FirstKCT</div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                <span style="font-size: 11px; color: var(--text-dim); font-family: var(--mono);">
                    Expected: @Model.ExpectedFirstKCT
                </span>
                <span class="badge badge-pass">PASS</span>
            </div>
        </div>

        <!-- 2nd KCT -->
        <div class="card card-accent-blue">
            <div class="card-title blue">2nd Section Decoder Key Token</div>
            <div class="token-label">2nd KCT (Set2ndSectionDecoderKey)</div>
            <div class="token-display">@Model.SecondKCT</div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px;">
                <span style="font-size: 11px; color: var(--text-dim); font-family: var(--mono);">
                    Expected: @Model.ExpectedSecondKCT
                </span>
                <span class="badge badge-pass">PASS</span>
            </div>
        </div>
    </div>

    <div>
        <!-- Key Migration Details -->
        <div class="card card-accent-purple">
            <div class="card-title purple">Key Migration Details</div>
            @if (Model.Request != null)
            {
                <div class="info-row">
                    <span class="label">Old SGC → New SGC</span>
                    <span class="value mono">@Model.Request.InitialSGC → @Model.Request.NewSGC</span>
                </div>
                <div class="info-row">
                    <span class="label">Old KRN → New KRN</span>
                    <span class="value mono">@Model.Request.InitialKRN → @Model.Request.NewKRN</span>
                </div>
                <div class="info-row">
                    <span class="label">Old TI → New TI</span>
                    <span class="value mono">@Model.Request.InitialTI.ToString("D2") → @Model.Request.NewTI.ToString("D2")</span>
                </div>
                <div class="info-row">
                    <span class="label">Base Date</span>
                    <span class="value mono">@Model.Request.InitialBaseDate → @Model.Request.NewBaseDate</span>
                </div>
            }
            <div class="info-row">
                <span class="label">NKHO</span>
                <span class="value" style="color: var(--success);">Verified ✓</span>
            </div>
            <div class="info-row">
                <span class="label">NKLO</span>
                <span class="value" style="color: var(--success);">Verified ✓</span>
            </div>
            <div class="info-row">
                <span class="label">KENHO</span>
                <span class="value" style="color: var(--success);">Verified ✓</span>
            </div>
            <div class="info-row">
                <span class="label">KENLO</span>
                <span class="value" style="color: var(--success);">Verified ✓</span>
            </div>
            <div class="info-row">
                <span class="label">Rollover Bit</span>
                <span class="value" style="color: var(--success);">0 ✓</span>
            </div>
        </div>

        <!-- Verification Summary -->
        <div class="card" style="background: var(--success-dim); border-color: rgba(16,185,129,0.3);">
            <div style="text-align: center;">
                <div style="font-size: 14px; font-weight: 800; color: var(--success); margin-bottom: 4px;">
                    ✓ All Key Fields Verified
                </div>
                <div style="font-size: 11px; color: var(--text-secondary);">
                    NKHO · NKLO · KENHO · KENLO · RO — All match expected values
                </div>
            </div>
        </div>
    </div>
</div>

<div style="display: flex; gap: 12px; margin-top: 16px;">
    <a href="/KeyChange" class="btn btn-secondary">🔑 New KeyChange</a>
    <a href="/" class="btn btn-ghost">← Dashboard</a>
</div>
