    // Populate test vector dropdown based on selected EA
    function populateTestVectors() {
        const ea = document.getElementById('tv-ea').value;
        const select = document.getElementById('tv-select');
        const vectors = testVectors[ea] || [];
        select.innerHTML = '<option value="">-- Manual entry --</option>';

        let lastGroup = '';
        vectors.forEach((v, i) => {
            const group = v.id.split('-')[0];
            if (group !== lastGroup) {
                const optgroup = document.createElement('optgroup');
                optgroup.label = group;
                vectors.filter(x => x.id.startsWith(group + '-')).forEach(x => {
                    const opt = document.createElement('option');
                    opt.value = vectors.indexOf(x);
                    opt.textContent = x.label;
                    optgroup.appendChild(opt);
                });
                select.appendChild(optgroup);
                lastGroup = group;
            }
        });
    }

    // Load selected test vector into all form fields
    function loadTestVector() {
        const ea = document.getElementById('tv-ea').value;
        const idx = document.getElementById('tv-select').value;
        if (idx === '') return;

        const v = testVectors[ea][parseInt(idx)];
        if (!v) return;

        // Set EA
        document.getElementById('vend-ea').value = ea;
        // Set PAN
        document.getElementById('vend-pan').value = v.pan;
        // Set register
        document.getElementById('vend-reg').value = v.reg;
        // Set TI
        document.getElementById('vend-ti').value = v.ti;
        // Set date
        document.getElementById('vend-date').value = v.date;
        // Set base date
        document.getElementById('vend-bd').value = v.bd;
        // Set category
        document.getElementById('vend-category').value = v.cat;
        onCategoryChanged();

        if (v.cat === 'credit') {
            document.getElementById('vend-ct').value = v.ct;
            document.getElementById('vend-amount').value = v.amount;
        } else {
            document.getElementById('vend-mgmt-type').value = v.mgmtType;
            document.getElementById('vend-mgmt-value').value = v.mgmtValue;
        }

        // Set expected token
        document.getElementById('vend-expected').value = v.expected;

        // Show info
        const info = document.getElementById('vend-tv-info');
        info.textContent = `Loaded: ${v.id} (EA${ea === '11' ? '11' : '07'}) — Expected: ${v.expected}`;
        info.style.display = 'block';

        // Hide old results
        document.getElementById('vend-result').style.display = 'none';
        document.getElementById('vend-error').style.display = 'none';
        document.getElementById('vend-pass-banner').style.display = 'none';
        document.getElementById('vend-comparison-card').style.display = 'none';
    }

    // Initialize test vector dropdown on page load
    document.addEventListener('DOMContentLoaded', () => populateTestVectors());

    function onCategoryChanged() {
        const cat = document.getElementById('vend-category').value;
        document.getElementById('credit-fields').style.display = cat === 'credit' ? 'block' : 'none';
        document.getElementById('mgmt-fields').style.display = cat === 'management' ? 'block' : 'none';
    }

    async function vendGenerateToken() {
        if (!window.vsmConnection.isConnected) {
            alert('VSM not connected. Go to Connection page first.');
            return;
        }

        const pan = document.getElementById('vend-pan').value;
        const reg = document.getElementById('vend-reg').value;
        const ti = document.getElementById('vend-ti').value;
        const dateStr = document.getElementById('vend-date').value;
        const bd = parseInt(document.getElementById('vend-bd').value);
        const ea = parseInt(document.getElementById('vend-ea').value);
        const category = document.getElementById('vend-category').value;

        // Hide previous results
        document.getElementById('vend-result').style.display = 'none';
        document.getElementById('vend-error').style.display = 'none';
        document.getElementById('vend-pass-banner').style.display = 'none';
        document.getElementById('vend-comparison-card').style.display = 'none';

        if (category === 'credit') {
            const ct = document.getElementById('vend-ct').value;
            const amount = parseFloat(document.getElementById('vend-amount').value);
            await generateToken(pan, reg, ti, ct, amount, dateStr, bd, ea);
        } else {
            const mgmtType = document.getElementById('vend-mgmt-type').value;
            const value = parseInt(document.getElementById('vend-mgmt-value').value);
            await generateManagementToken(pan, reg, ti, mgmtType, value, dateStr, bd, ea);
        }
    }

    // Handle token received (both credit and management use ReceiveToken)
    window.onTokenReceived = function(result) {
        const resultDiv = document.getElementById('vend-result');
        const errorDiv = document.getElementById('vend-error');
        const banner = document.getElementById('vend-pass-banner');
        const valueDiv = document.getElementById('vend-token-value');
        const eaDiv = document.getElementById('vend-token-ea');
        const compCard = document.getElementById('vend-comparison-card');
        const expectedInput = document.getElementById('vend-expected');

        if (result.token) {
            valueDiv.textContent = result.token;
            eaDiv.textContent = `EA${result.ea === 11 ? '11' : '07'} · Generated at ${new Date().toLocaleTimeString()}`;
            resultDiv.style.display = 'block';
            errorDiv.style.display = 'none';

            // Compare with expected if provided
            const expectedRaw = expectedInput.value.trim();
            if (expectedRaw) {
                const expected = expectedRaw.replace(/\s/g, '');
                const actual = result.token.replace(/\s/g, '');
                const passed = actual === expected;

                // PASS/FAIL banner
                banner.style.display = 'block';
                banner.textContent = passed ? 'PASS' : 'FAIL';
                banner.style.background = passed ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
                banner.style.color = passed ? 'var(--success)' : 'var(--error)';
                banner.style.border = passed ? '2px solid var(--success)' : '2px solid var(--error)';

                // Show comparison card
                compCard.style.display = 'block';
                document.getElementById('vend-expected-display').textContent = expectedRaw;
                const actualDisplay = document.getElementById('vend-actual-display');
                actualDisplay.textContent = result.token;
                actualDisplay.style.color = passed ? 'var(--success)' : 'var(--error)';

                // Digit-by-digit diff
                const diffDiv = document.getElementById('vend-digit-diff');
                if (!passed) {
                    let html = '';
                    for (let i = 0; i < Math.max(actual.length, expected.length); i++) {
                        const a = actual[i] || '';
                        const e = expected[i] || '';
                        if (a === e) {
                            html += `<span style="color: var(--text-dim);">${a}</span>`;
                        } else {
                            html += `<span style="color: var(--error); font-weight: bold; text-decoration: underline;">${a || '_'}</span>`;
                        }
                    }
                    diffDiv.innerHTML = '<div style="margin-top: 4px; font-size: 10px; color: var(--text-dim);">Mismatched digits highlighted:</div>' + html;
                    diffDiv.style.display = 'block';
                } else {
                    diffDiv.innerHTML = '<span style="color: var(--success);">All 20 digits match</span>';
                    diffDiv.style.display = 'block';
                }

                // Log to activity
                const log = document.getElementById('progress-log');
                if (log) {
                    const tvSelect = document.getElementById('tv-select');
                    const tvLabel = tvSelect.selectedIndex > 0 ? tvSelect.options[tvSelect.selectedIndex].text : 'Manual';
                    log.innerHTML += `<div class="log-entry" style="color: ${passed ? 'var(--success)' : 'var(--error)'};">${formatTime()} ${passed ? 'PASS' : 'FAIL'} — ${tvLabel}</div>`;
                    log.innerHTML += `<div class="log-entry">${formatTime()} Expected: ${expectedRaw}</div>`;
                    log.innerHTML += `<div class="log-entry">${formatTime()} Got:      ${result.token}</div>`;
                    log.scrollTop = log.scrollHeight;
                }
            } else {
                banner.style.display = 'none';
                compCard.style.display = 'none';
            }
        } else {
            document.getElementById('vend-error-text').textContent = 'Error: ' + result.error;
            errorDiv.style.display = 'block';
            resultDiv.style.display = 'none';
            banner.style.display = 'none';
        }
    };

    function copyToken() {
        const token = document.getElementById('vend-token-value').textContent;
        navigator.clipboard.writeText(token);
    }

    // Update connection banner on status change
    window.addEventListener('vsmStatusChanged', (e) => {
        const status = e.detail;
        const dot = document.getElementById('vend-status-dot');
        const text = document.getElementById('vend-status-text');
        if (dot && text) {
            dot.style.background = status.isConnected ? 'var(--success)' : 'var(--error)';
            text.textContent = status.isConnected ? `VSM Connected (${status.connectedPort})` : 'VSM Not Connected';
            text.style.color = status.isConnected ? 'var(--success)' : 'var(--error)';
        }
    });
</script>
}
