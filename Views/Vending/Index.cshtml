@inject STSCompliancePOS.Services.VSMConfiguration Config
@{ ViewData["Title"] = "Vend Token"; }

<div class="page-header">
    <h2>Vend Token</h2>
    <div class="subtitle">Generate real STS tokens via VSM hardware</div>
</div>

<!-- Connection Status Banner -->
<div id="vend-conn-banner" class="card" style="padding: 10px 16px; margin-bottom: 16px; display: flex; align-items: center; gap: 10px; border-color: @(ViewBag.IsConnected == true ? "rgba(16,185,129,0.3)" : "rgba(239,68,68,0.3)");">
    <div id="vend-status-dot" style="width: 10px; height: 10px; border-radius: 50%; background: @(ViewBag.IsConnected == true ? "var(--success)" : "var(--error)");"></div>
    <span id="vend-status-text" style="font-size: 12px; color: @(ViewBag.IsConnected == true ? "var(--success)" : "var(--error)");">
        @(ViewBag.IsConnected == true ? $"VSM Connected ({ViewBag.ConnectedPort})" : "VSM Not Connected — connect on the Connection page first")
    </span>
</div>

<!-- Load Test Vector -->
<div class="card card-accent-warn" style="margin-bottom: 16px;">
    <div class="card-title warn">Load Test Vector (auto-fill parameters + expected token)</div>
    <div class="grid-2">
        <div class="form-group">
            <label>EA Version</label>
            <select class="form-control" id="tv-ea" onchange="populateTestVectors()">
                <option value="7">EA07 (STS 531-1-07)</option>
                <option value="11">EA11 (STS 531-1-11)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Test Vector</label>
            <select class="form-control" id="tv-select" onchange="loadTestVector()">
                <option value="">-- Manual entry --</option>
            </select>
        </div>
    </div>
</div>

<div class="grid-2">
    <!-- APDU / Token Parameters -->
    <div>
        <div class="card card-accent-blue">
            <div class="card-title blue">Token Parameters</div>

            <div class="form-group">
                <label>MeterPAN</label>
                <select class="form-control" id="vend-pan">
                    <option value="@Config.TestPANs.PAN_11">@Config.TestPANs.PAN_11 (11-digit DRN)</option>
                    <option value="@Config.TestPANs.PAN_13">@Config.TestPANs.PAN_13 (13-digit DRN)</option>
                    <option value="@Config.TestPANs.PAN_CTSA15">@Config.TestPANs.PAN_CTSA15 (CTSA15)</option>
                </select>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Key Register</label>
                    <select class="form-control" id="vend-reg">
                        @foreach (var reg in Config.KeyRegisters)
                        {
                            <!option value="@reg.Value.Register"
                                     selected="@reg.Value.IsDefault"
                                     style="@(reg.Value.IsExpired ? "color:var(--error)" : "")">
                                @reg.Key — @reg.Value.Description
                            </!option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>TI</label>
                    <input type="text" class="form-control" id="vend-ti" value="01" />
                </div>
            </div>

            <div class="form-group">
                <label>Encryption Algorithm (EA)</label>
                <select class="form-control" id="vend-ea">
                    <option value="7">EA07 (STS 531-1-07)</option>
                    <option value="11">EA11 (STS 531-1-11)</option>
                </select>
            </div>

            <div class="grid-2">
                <div class="info-row">
                    <span class="label">DKGA</span>
                    <span class="value mono">@Config.TokenGeneration.DKGA.ToString("D2")</span>
                </div>
                <div class="info-row">
                    <span class="label">KEN</span>
                    <span class="value mono">255 (0xFF)</span>
                </div>
            </div>
        </div>

        <!-- Base Date -->
        <div class="card card-accent-purple">
            <div class="card-title purple">Timing</div>
            <div class="grid-2">
                <div class="form-group">
                    <label>Issue Date</label>
                    <input type="datetime-local" class="form-control" id="vend-date" value="2014-03-01T13:00" />
                </div>
                <div class="form-group">
                    <label>Base Date</label>
                    <select class="form-control" id="vend-bd">
                        @for (int y = 2011; y <= 2027; y++)
                        {
                            <option value="@y" selected="@(y == 2014)">@y</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Token Type & Generation -->
    <div>
        <div class="card card-accent-green">
            <div class="card-title green">Token Type</div>

            <div class="form-group">
                <label>Category</label>
                <select class="form-control" id="vend-category" onchange="onCategoryChanged()">
                    <option value="credit">Credit Token (TransferCredit)</option>
                    <option value="management">Management Token</option>
                </select>
            </div>

            <!-- Credit-specific fields -->
            <div id="credit-fields">
                <div class="grid-2">
                    <div class="form-group">
                        <label>Credit Type</label>
                        <select class="form-control" id="vend-ct">
                            <option value="0">Electricity (kWh)</option>
                            <option value="1">Water (kL)</option>
                            <option value="2">Gas (m3)</option>
                            <option value="3">Time (min)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Amount</label>
                        <input type="number" class="form-control" id="vend-amount" value="0.1" step="0.1" />
                    </div>
                </div>
            </div>

            <!-- Management-specific fields -->
            <div id="mgmt-fields" style="display: none;">
                <div class="form-group">
                    <label>Management Type</label>
                    <select class="form-control" id="vend-mgmt-type">
                        <option value="0">SetMaximumPowerLimit (MPL)</option>
                        <option value="1">ClearCredit</option>
                        <option value="5">ClearTamperCondition</option>
                        <option value="6">SetMaxPhasePowerUnbalanceLimit (MPUL)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Value (register/limit)</label>
                    <input type="number" class="form-control" id="vend-mgmt-value" value="65535" />
                    <div style="font-size: 10px; color: var(--text-dim); margin-top: 4px;">
                        ClearCredit: 0xFFFF (65535) · MPL/MPUL: power in 0.1W units · ClearTamper: 0
                    </div>
                </div>
            </div>
        </div>

        <button class="btn btn-primary" style="width: 100%; text-align: center; padding: 14px;" onclick="vendGenerateToken()">
            GENERATE TOKEN
        </button>

        <!-- PASS/FAIL Banner -->
        <div id="vend-pass-banner" style="display: none; margin-top: 16px; text-align: center; padding: 14px; border-radius: 8px; font-weight: 800; font-size: 16px; letter-spacing: 2px;"></div>

        <!-- Result Display -->
        <div id="vend-result" style="display: none; margin-top: 16px;">
            <!-- Generated Token from VSM -->
            <div class="card card-accent-green">
                <div class="card-title green">Generated Token (from VSM)</div>
                <div class="token-label">20-Digit STS Token</div>
                <div class="token-display" id="vend-token-value" style="cursor: pointer;" onclick="copyToken()" title="Click to copy"></div>
                <div id="vend-token-ea" style="font-size: 11px; color: var(--text-dim); margin-top: 6px;"></div>
            </div>

            <!-- Expected vs Generated Comparison -->
            <div id="vend-comparison-card" class="card card-accent-blue" style="display: none;">
                <div class="card-title blue">Expected vs Generated</div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div>
                        <div style="font-size: 10px; color: var(--text-dim); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px;">Expected (from spec)</div>
                        <div id="vend-expected-display" style="font-family: var(--mono); font-size: 14px; color: var(--accent); letter-spacing: 2px; background: #000; padding: 10px; border-radius: 6px; text-align: center;"></div>
                    </div>
                    <div>
                        <div style="font-size: 10px; color: var(--text-dim); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 1px;">Generated (from VSM)</div>
                        <div id="vend-actual-display" style="font-family: var(--mono); font-size: 14px; letter-spacing: 2px; background: #000; padding: 10px; border-radius: 6px; text-align: center;"></div>
                    </div>
                </div>
                <!-- Digit-by-digit comparison -->
                <div id="vend-digit-diff" style="margin-top: 10px; font-family: var(--mono); font-size: 12px; text-align: center; letter-spacing: 3px;"></div>
            </div>
        </div>

        <div id="vend-error" style="display: none; margin-top: 16px;">
            <div class="verify-box verify-fail">
                <span class="verify-text" id="vend-error-text"></span>
            </div>
        </div>

        <!-- Validation — expected token input -->
        <div class="card" style="margin-top: 16px;">
            <div class="card-title" style="color: var(--text-dim);">Validation</div>
            <div class="form-group">
                <label>Expected Token (auto-filled from test vector, or enter manually)</label>
                <input type="text" class="form-control" id="vend-expected" placeholder="e.g. 7063 0503 4700 2872 6114" />
            </div>
            <div id="vend-tv-info" style="display: none; font-size: 11px; color: var(--text-dim); margin-top: 6px;"></div>
        </div>

        <!-- Activity Log -->
        <div class="card">
            <div class="card-title" style="color: var(--text-dim);">Activity Log</div>
            <div id="progress-log" style="height: 120px; overflow-y: auto; background: #000; border-radius: 6px; padding: 10px; font-family: var(--mono); font-size: 11px; color: var(--text-dim);">
                <div class="log-entry">[Ready] Waiting for token generation...</div>
            </div>
        </div>
    </div>
</div>

