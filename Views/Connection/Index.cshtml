@model STSCompliancePOS.Services.ConnectionStatus
@inject STSCompliancePOS.Services.VSMConfiguration Config
@{ ViewData["Title"] = "VSM Connection"; }

<!-- Toast Notification -->
<div id="toast-notification" style="display: none; position: fixed; top: 24px; right: 24px; z-index: 9999; min-width: 320px; padding: 16px 24px; border-radius: 10px; font-weight: 700; font-size: 15px; letter-spacing: 1px; box-shadow: 0 8px 32px rgba(0,0,0,0.5); transition: opacity 0.3s, transform 0.3s; transform: translateY(-10px); opacity: 0;">
    <div style="display: flex; align-items: center; gap: 12px;">
        <span id="toast-icon" style="font-size: 24px;"></span>
        <div>
            <div id="toast-title" style="font-size: 16px;"></div>
            <div id="toast-detail" style="font-size: 11px; font-weight: 400; margin-top: 2px; opacity: 0.8;"></div>
        </div>
    </div>
</div>

<div class="page-header">
    <h2>VSM Connection</h2>
    <div class="subtitle">@Config.DeviceModel (@Config.FirmwareVersion) · @Config.Protocol</div>
</div>

<div class="grid-2">
    <!-- Connection Panel -->
    <div>
        <div class="card card-accent-green" id="connection-card">
            <div class="card-title green">COM Port Connection</div>

            <div class="form-group">
                <label>Select COM Port</label>
                <div style="display: flex; gap: 8px;">
                    <select class="form-control" id="port-select" style="flex: 1;">
                        <option value="">Select COM Port...</option>
                        @foreach (var port in Model.AvailablePorts)
                        {
                            <!option value="@port" selected="@(port == Model.ConnectedPort)">@port</!option>                        }
                    </select>
                    <button class="btn btn-ghost btn-sm" onclick="refreshPorts()" title="Refresh">🔄</button>
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Baud Rate</label>
                    <input type="text" class="form-control" value="@Config.SerialPort.BaudRate" disabled />
                </div>
                <div class="form-group">
                    <label>Format</label>
                    <input type="text" class="form-control" value="@Config.SerialPort.DataBits@(Config.SerialPort.Parity[0])@Config.SerialPort.StopBits" disabled />
                </div>
            </div>

            <div class="grid-2" style="margin-bottom: 14px;">
                <div class="info-row">
                    <span class="label">Read Timeout</span>
                    <span class="value mono">@Config.SerialPort.ReadTimeout ms</span>
                </div>
                <div class="info-row">
                    <span class="label">Write Timeout</span>
                    <span class="value mono">@Config.SerialPort.WriteTimeout ms</span>
                </div>
            </div>

            <button id="connect-btn" class="btn @(Model.IsConnected ? "btn-secondary" : "btn-primary")"
                    style="width: 100%; margin-bottom: 12px;"
                    onclick="toggleConnection()">
                @(Model.IsConnected ? "Disconnect" : "Connect")
            </button>

            @if (!string.IsNullOrEmpty(Model.LastError))
            {
                <div class="verify-box verify-fail">
                    <span class="verify-text">Error: @Model.LastError</span>
                </div>
            }
        </div>

        <!-- Connection Status -->
        <div class="card" id="status-card">
            <div class="card-title" style="color: var(--text-dim);">Connection Status</div>
            <div class="info-row">
                <span class="label">Status</span>
                <span class="value" id="conn-status-text" style="color: @(Model.IsConnected ? "var(--success)" : "var(--error)")">
                    @(Model.IsConnected ? "● Connected" : "○ Disconnected")
                </span>
            </div>
            <div class="info-row">
                <span class="label">Port</span>
                <span class="value mono" id="conn-port-text">@(Model.ConnectedPort ?? "—")</span>
            </div>
            <div class="info-row">
                <span class="label">Device</span>
                <span class="value mono">@Config.DeviceModel</span>
            </div>
            <div class="info-row">
                <span class="label">Protocol</span>
                <span class="value mono">@Config.Protocol</span>
            </div>
            <div class="info-row">
                <span class="label">CRC</span>
                <span class="value mono">CRC-16/ARC</span>
            </div>
        </div>

        <!-- Token Generation Config -->
        <div class="card card-accent-purple">
            <div class="card-title purple">Token Generation Config</div>
            <div class="grid-2">
                <div class="info-row">
                    <span class="label">DKGA</span>
                    <span class="value mono">@Config.TokenGeneration.DKGA.ToString("D2")</span>
                </div>
                <div class="info-row">
                    <span class="label">EA</span>
                    <span class="value mono">@Config.TokenGeneration.EA.ToString("D2")</span>
                </div>
                <div class="info-row">
                    <span class="label">TCT</span>
                    <span class="value mono">@Config.TokenGeneration.TCT</span>
                </div>
                <div class="info-row">
                    <span class="label">RND (Fixed)</span>
                    <span class="value mono">@Config.TokenGeneration.RND</span>
                </div>
            </div>
            <div style="margin-top: 10px; font-size: 10px; color: var(--text-dim);">
                ⚙️ Edit appsettings.json to modify these values
            </div>
        </div>
    </div>

    <!-- Quick Test Panel -->
    <div>
        <div class="card card-accent-warn">
            <div class="card-title warn">Quick Token Test</div>

            <div class="form-group">
                <label>MeterPAN</label>
                <select class="form-control" id="test-pan">
                    <option value="@Config.TestPANs.PAN_11">@Config.TestPANs.PAN_11 (11-digit DRN)</option>
                    <option value="@Config.TestPANs.PAN_13">@Config.TestPANs.PAN_13 (13-digit DRN)</option>
                    <option value="@Config.TestPANs.PAN_CTSA15">@Config.TestPANs.PAN_CTSA15 (CTSA15)</option>
                </select>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Key Register</label>
                    <select class="form-control" id="test-reg">
                        @foreach (var reg in Config.KeyRegisters)
                        {
                            <!option value="@reg.Value.Register" 
                                     selected="@reg.Value.IsDefault"
                                     style="@(reg.Value.IsExpired ? "color:var(--error)" : "")">
                                @reg.Key — @reg.Value.Description
                            </!option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>TI</label>
                    <input type="text" class="form-control" id="test-ti" value="01" />
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Credit Type</label>
                    <select class="form-control" id="test-ct">
                        <option value="0">Electricity (kWh)</option>
                        <option value="1">Water (kL)</option>
                        <option value="2">Gas (m³)</option>
                        <option value="3">Time (min)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Amount</label>
                    <input type="number" class="form-control" id="test-amount" value="0.1" step="0.1" />
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label>Issue Date</label>
                    <input type="datetime-local" class="form-control" id="test-date" value="2014-03-01T13:00" />
                </div>
                <div class="form-group">
                    <label>Base Date</label>
                    <select class="form-control" id="test-bd">
                        <option value="2014">2014</option>
                        <option value="2035">2035</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Encryption Algorithm (EA)</label>
                <select class="form-control" id="test-ea">
                    <option value="7">EA07 (STS 531-1-07)</option>
                    <option value="11">EA11 (STS 531-1-11)</option>
                </select>
            </div>

            <button class="btn btn-primary" style="width: 100%;" onclick="quickTokenTest()">
                ⚡ Generate Token
            </button>

            <div id="token-result" style="margin-top: 12px; display: none;">
                <div class="token-label">Generated Token</div>
                <div class="token-display" id="token-value"></div>
            </div>

            <div class="form-group" style="margin-top: 12px;">
                <label>Expected Token (optional, for comparison)</label>
                <input type="text" class="form-control" id="expected-token" placeholder="e.g. 7063 0503 4700 2872 6114" />
            </div>
            <div id="compare-result" style="display: none;"></div>
        </div>

        <!-- Progress Log -->
        <div class="card">
            <div class="card-title" style="color: var(--text-dim);">Activity Log</div>
            <div id="progress-log" style="height: 180px; overflow-y: auto; background: #000; border-radius: 6px; padding: 10px; font-family: var(--mono); font-size: 11px; color: var(--text-dim);">
                <div class="log-entry">[Ready] Waiting for connection...</div>
            </div>
            <button class="btn btn-ghost btn-sm" style="margin-top: 8px;" onclick="clearLog()">Clear Log</button>
        </div>
    </div>
</div>

<!-- Key Registers Table -->
<div class="card" style="margin-top: 16px;">
    <div class="card-title" style="color: var(--text-dim);">Pre-loaded Key Registers (from appsettings.json)</div>
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
            <thead>
                <tr style="background: var(--bg-surface); color: var(--accent);">
                    <th style="padding: 10px; text-align: left; border-bottom: 1px solid var(--card-border);">Register</th>
                    <th style="padding: 10px; text-align: left; border-bottom: 1px solid var(--card-border);">Description</th>
                    <th style="padding: 10px; text-align: left; border-bottom: 1px solid var(--card-border);">SGC</th>
                    <th style="padding: 10px; text-align: left; border-bottom: 1px solid var(--card-border);">KRN</th>
                    <th style="padding: 10px; text-align: left; border-bottom: 1px solid var(--card-border);">BD</th>
                    <th style="padding: 10px; text-align: left; border-bottom: 1px solid var(--card-border);">KEN</th>
                    <th style="padding: 10px; text-align: left; border-bottom: 1px solid var(--card-border);">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reg in Config.KeyRegisters)
                {
                    <tr style="border-bottom: 1px solid var(--card-border);">
                        <td style="padding: 10px; font-family: var(--mono); color: var(--accent);">VKREG@reg.Value.Register</td>
                        <td style="padding: 10px;">@reg.Value.Description</td>
                        <td style="padding: 10px; font-family: var(--mono);">@reg.Value.SGC</td>
                        <td style="padding: 10px; font-family: var(--mono);">@reg.Value.KRN</td>
                        <td style="padding: 10px; font-family: var(--mono);">@reg.Value.BaseDate</td>
                        <td style="padding: 10px; font-family: var(--mono); color: @(reg.Value.KEN < 255 ? "var(--warn)" : "var(--text)")">@reg.Value.KEN</td>
                        <td style="padding: 10px;">
                            @if (reg.Value.IsExpired)
                            {
                                <span class="badge badge-fail">EXPIRED</span>
                            }
                            else if (reg.Value.IsDefault)
                            {
                                <span class="badge badge-pass">DEFAULT</span>
                            }
                            else
                            {
                                <span class="badge badge-info">OK</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Run Compliance Tests -->
<div class="card card-accent-blue" style="margin-top: 16px;">
    <div class="card-title blue">Run Real Compliance Tests</div>
    <div class="grid-4" style="margin-bottom: 14px;">
        <div class="form-group">
            <label>Utility Type</label>
            <select class="form-control" id="suite-utility">
                <option value="E">Electricity</option>
                <option value="W">Water</option>
                <option value="G">Gas</option>
                <option value="T">Time</option>
            </select>
        </div>
        <div class="form-group">
            <label>Encryption Algorithm</label>
            <select class="form-control" id="suite-ea">
                <option value="7">EA07 (STS 531-1-07)</option>
                <option value="11">EA11 (STS 531-1-11)</option>
                <option value="both">Both EA07 + EA11 (160 tests)</option>
            </select>
        </div>
        <div class="form-group">
            <label style="display: flex; align-items: center; gap: 6px; margin-top: 24px;">
                <input type="checkbox" id="suite-currency" /> Include Currency
            </label>
        </div>
        <div class="form-group">
            <label style="display: flex; align-items: center; gap: 6px; margin-top: 24px;">
                <input type="checkbox" id="suite-keychange" /> Include Keychange
            </label>
        </div>
    </div>
    <div class="grid-2" style="margin-bottom: 14px;">
        <div class="form-group">
            <label style="display: flex; align-items: center; gap: 6px;">
                <input type="checkbox" id="suite-extended" /> Extended (STS202-5)
            </label>
        </div>
        <div class="info-row">
            <span class="label">POS Report</span>
            <span class="value mono" style="color: var(--accent);">Total: 160 tests (80×EA07 + 80×EA11)</span>
        </div>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button class="btn btn-primary" onclick="runFullSuite()">
            🧪 Run Compliance Suite
        </button>
        <button class="btn btn-primary" style="background: var(--warn);" id="run-pos-btn" onclick="runFullPOS()">
            📋 Run All 160 POS Tests
        </button>
        <button class="btn btn-secondary" onclick="exportResults('csv')">
            📄 Export CSV
        </button>
        <button class="btn btn-secondary" onclick="exportResults('html')">
            🌐 Export HTML
        </button>
        <button class="btn btn-ghost" onclick="printReport()">
            🖨️ Print Report
        </button>
    </div>

    <!-- POS Test Progress Overlay -->
    <div id="pos-progress-overlay" style="display: none; margin-top: 16px; padding: 16px; background: var(--bg-surface); border: 1px solid var(--card-border); border-radius: 8px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <div id="pos-spinner" style="width: 24px; height: 24px; border: 3px solid var(--card-border); border-top: 3px solid var(--accent); border-radius: 50%; animation: spin 1s linear infinite;"></div>
            <span id="pos-progress-title" style="font-weight: bold; color: var(--accent); font-size: 14px;">Running All 160 POS Tests...</span>
        </div>
        <div style="margin-bottom: 8px;">
            <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--text-dim); margin-bottom: 4px;">
                <span id="pos-progress-label">Initializing...</span>
                <span id="pos-progress-count"></span>
            </div>
            <div style="height: 6px; background: var(--card-border); border-radius: 3px; overflow: hidden;">
                <div id="pos-progress-bar" style="height: 100%; background: var(--accent); border-radius: 3px; width: 0%; transition: width 0.3s ease;"></div>
            </div>
        </div>
        <div id="pos-live-log" style="height: 200px; overflow-y: auto; background: #000; border-radius: 6px; padding: 10px; font-family: var(--mono); font-size: 11px; color: var(--text-dim);"></div>
    </div>
</div>

<style>
    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

@section Scripts {
<script>
    // Toggle connection
    async function toggleConnection() {
        const portSelect = document.getElementById('port-select');
        const port = portSelect.value;

        if (window.vsmConnection.isConnected) {
            await disconnectVSM();
        } else {
            if (!port) {
                alert('Please select a COM port');
                return;
            }
            await connectVSM(port);
        }
    }

    // Quick token test
    async function quickTokenTest() {
        if (!window.vsmConnection.isConnected) {
            alert('VSM not connected');
            return;
        }

        const pan = document.getElementById('test-pan').value;
        const reg = document.getElementById('test-reg').value;
        const ti = document.getElementById('test-ti').value;
        const ct = document.getElementById('test-ct').value;
        const amount = parseFloat(document.getElementById('test-amount').value);
        const dateStr = document.getElementById('test-date').value;
        const bd = parseInt(document.getElementById('test-bd').value);
        const ea = parseInt(document.getElementById('test-ea').value);

        await generateToken(pan, reg, ti, ct, amount, dateStr, bd, ea);
    }

    // Handle token received
    window.onTokenReceived = function(result) {
        const resultDiv = document.getElementById('token-result');
        const valueDiv = document.getElementById('token-value');
        const compareDiv = document.getElementById('compare-result');
        const expectedInput = document.getElementById('expected-token');

        if (result.token) {
            valueDiv.textContent = result.token;
            valueDiv.style.color = 'var(--accent)';
            resultDiv.style.display = 'block';

            // Compare with expected if provided
            const expectedRaw = expectedInput.value.trim();
            const expected = expectedRaw.replace(/\s/g, '');
            if (expected) {
                const actual = result.token.replace(/\s/g, '');
                const passed = actual === expected;

                if (passed) {
                    compareDiv.innerHTML = '<div class="verify-box verify-pass"><span class="verify-text">\u2713 MATCH \u2014 Token matches expected value!</span></div>';
                } else {
                    compareDiv.innerHTML = '<div class="verify-box verify-fail"><span class="verify-text">\u2717 MISMATCH \u2014 Token does not match expected value</span></div>';
                }
                compareDiv.style.display = 'block';

                // Log to SQLite
                const logEa = parseInt(document.getElementById('test-ea').value);
                const logPan = document.getElementById('test-pan').value;
                const logReg = document.getElementById('test-reg').value;
                const logTi = document.getElementById('test-ti').value;
                const logCt = document.getElementById('test-ct').value;
                const logAmount = parseFloat(document.getElementById('test-amount').value);
                const logDate = document.getElementById('test-date').value;
                const logBd = parseInt(document.getElementById('test-bd').value);

                logTokenTest('QuickTest', logEa, 'credit', logPan, logReg, logTi,
                    logCt, logAmount, null, null, logDate, logBd,
                    expectedRaw, result.token, passed);

                // Alert
                if (passed) {
                    alert('PASS: Token matches expected value!\n\nToken: ' + result.token);
                } else {
                    alert('FAIL: Token does not match!\n\nExpected: ' + expectedRaw + '\nGot: ' + result.token);
                }

                // Toast
                showConnToast(passed, passed ? 'TOKEN MATCH' : 'TOKEN MISMATCH', result.token);
            } else {
                compareDiv.style.display = 'none';
            }
        } else {
            valueDiv.textContent = 'Error: ' + result.error;
            valueDiv.style.color = 'var(--error)';
            resultDiv.style.display = 'block';
            compareDiv.style.display = 'none';
            showConnToast(false, 'Token Error', result.error);
        }
    };

    // Run full suite
    async function runFullSuite() {
        if (!window.vsmConnection.isConnected) {
            alert('VSM not connected. Please connect first.');
            return;
        }

        const utility = document.getElementById('suite-utility').value;
        const currency = document.getElementById('suite-currency').checked;
        const keychange = document.getElementById('suite-keychange').checked;
        const extended = document.getElementById('suite-extended').checked;
        const eaSelect = document.getElementById('suite-ea').value;

        if (eaSelect === 'both') {
            // Run both suites sequentially
            await runFullPOS();
            return;
        }

        const ea = parseInt(eaSelect);
        await runFullTestSuite(utility, currency, keychange, extended, ea);
    }

    // Run all 160 POS tests (EA07 + EA11) via SignalR with live progress
    let posTestRunning = false;
    let posStepCount = 0;

    async function runFullPOS() {
        if (!window.vsmConnection.isConnected) {
            alert('VSM not connected. Please connect first.');
            return;
        }
        if (posTestRunning) {
            alert('POS tests already running. Please wait.');
            return;
        }

        const utility = document.getElementById('suite-utility').value;
        const currency = document.getElementById('suite-currency').checked;
        const keychange = document.getElementById('suite-keychange').checked;
        const extended = document.getElementById('suite-extended').checked;
        const log = document.getElementById('progress-log');

        // Show overlay & disable button
        posTestRunning = true;
        posStepCount = 0;
        const overlay = document.getElementById('pos-progress-overlay');
        const liveLog = document.getElementById('pos-live-log');
        const progressBar = document.getElementById('pos-progress-bar');
        const progressLabel = document.getElementById('pos-progress-label');
        const progressCount = document.getElementById('pos-progress-count');
        const progressTitle = document.getElementById('pos-progress-title');
        const spinner = document.getElementById('pos-spinner');
        const btn = document.getElementById('run-pos-btn');

        overlay.style.display = 'block';
        liveLog.innerHTML = '';
        progressBar.style.width = '0%';
        progressBar.style.background = 'var(--accent)';
        progressLabel.textContent = 'Initializing...';
        progressCount.textContent = '0 / 160';
        progressTitle.textContent = 'Running All 160 POS Tests...';
        progressTitle.style.color = 'var(--accent)';
        spinner.style.animation = 'spin 1s linear infinite';
        spinner.style.borderTopColor = 'var(--accent)';
        btn.disabled = true;
        btn.style.opacity = '0.5';

        log.innerHTML += '<div class="log-entry" style="color: var(--accent);">═══ Running ALL 160 POS Tests (EA07 + EA11) ═══</div>';
        log.scrollTop = log.scrollHeight;

        // Hook into ReceiveProgress to update live log
        const originalOnProgress = window._posProgressHandler;
        window._posProgressHandler = function(message) {
            // Update live log
            liveLog.innerHTML += `<div style="margin-bottom: 2px;">${formatTime()} ${message}</div>`;
            liveLog.scrollTop = liveLog.scrollHeight;

            // Count completed steps (look for PASS/FAIL patterns)
            if (message.includes('PASS') || message.includes('FAIL') || message.includes('passed') || message.includes('Step')) {
                posStepCount++;
                const pct = Math.min((posStepCount / 160) * 100, 100);
                progressBar.style.width = pct + '%';
                progressCount.textContent = `${Math.min(posStepCount, 160)} / 160`;
            }

            // Update label based on phase
            if (message.includes('[EA07]')) {
                progressLabel.textContent = 'Running EA07 tests...';
            } else if (message.includes('[EA11]')) {
                progressLabel.textContent = 'Running EA11 tests...';
            } else if (message.includes('EA07 Done')) {
                progressLabel.textContent = 'EA07 complete, starting EA11...';
            }
        };

        // Intercept SignalR ReceiveProgress
        const hub = window.vsmConnection.hub;
        hub.off("ReceiveProgress");
        hub.on("ReceiveProgress", (message) => {
            console.log("[VSM]", message);
            // Update activity log
            const mainLog = document.getElementById("progress-log");
            if (mainLog) {
                mainLog.innerHTML += `<div class="log-entry">${formatTime()} ${message}</div>`;
                mainLog.scrollTop = mainLog.scrollHeight;
            }
            // Update overlay
            if (window._posProgressHandler) window._posProgressHandler(message);
        });

        try {
            await runFullPOSTests(utility, currency, keychange, extended);
        } catch (e) {
            log.innerHTML += `<div class="log-entry" style="color: var(--error)">Error: ${e.message}</div>`;
            finishPOSOverlay(false, e.message);
        }
    }

    // Handle full POS completion
    window.onFullPOSComplete = function(result) {
        const allPassed = result.allPassed;
        const log = document.getElementById('progress-log');
        const color = allPassed ? 'var(--success)' : 'var(--error)';

        log.innerHTML += `<div class="log-entry" style="color: ${color}">═══ EA07: ${result.ea07Result.totalPassed}/${result.ea07Result.totalSteps} passed ═══</div>`;
        log.innerHTML += `<div class="log-entry" style="color: ${color}">═══ EA11: ${result.ea11Result.totalPassed}/${result.ea11Result.totalSteps} passed ═══</div>`;
        log.innerHTML += `<div class="log-entry" style="color: ${color}; font-weight: bold;">═══ TOTAL: ${result.totalPassed}/${result.totalTests} passed ═══</div>`;
        log.scrollTop = log.scrollHeight;

        finishPOSOverlay(allPassed,
            `${result.totalPassed}/${result.totalTests} passed (EA07: ${result.ea07Result.totalPassed}/${result.ea07Result.totalSteps}, EA11: ${result.ea11Result.totalPassed}/${result.ea11Result.totalSteps})`);

        if (confirm(`Test complete: ${result.totalPassed}/${result.totalTests} passed.\n\nExport results?`)) {
            exportResults('csv');
        }
    };

    function finishPOSOverlay(success, message) {
        const progressBar = document.getElementById('pos-progress-bar');
        const progressLabel = document.getElementById('pos-progress-label');
        const progressTitle = document.getElementById('pos-progress-title');
        const progressCount = document.getElementById('pos-progress-count');
        const spinner = document.getElementById('pos-spinner');
        const btn = document.getElementById('run-pos-btn');

        // Stop spinner — remove animation and hide
        spinner.style.animation = 'none';
        spinner.style.borderTopColor = success ? 'var(--success)' : 'var(--error)';

        progressBar.style.width = '100%';
        progressBar.style.background = success ? 'var(--success)' : 'var(--error)';
        progressLabel.textContent = message;
        progressCount.textContent = 'Done';
        progressTitle.textContent = success ? 'All Tests Passed!' : 'Tests Complete (with failures)';
        progressTitle.style.color = success ? 'var(--success)' : 'var(--error)';

        btn.disabled = false;
        btn.style.opacity = '1';
        posTestRunning = false;

        // Restore normal SignalR handler
        const hub = window.vsmConnection.hub;
        hub.off("ReceiveProgress");
        hub.on("ReceiveProgress", (msg) => {
            console.log("[VSM]", msg);
            const log = document.getElementById("progress-log");
            if (log) {
                log.innerHTML += `<div class="log-entry">${formatTime()} ${msg}</div>`;
                log.scrollTop = log.scrollHeight;
            }
        });
        window._posProgressHandler = null;
    }

    function showConnToast(success, title, detail) {
        const toast = document.getElementById('toast-notification');
        toast.style.display = 'block';
        toast.style.background = success ? 'rgba(16,185,129,0.12)' : 'rgba(239,68,68,0.12)';
        toast.style.border = success ? '2px solid rgba(16,185,129,0.5)' : '2px solid rgba(239,68,68,0.5)';
        toast.style.color = success ? 'var(--success)' : 'var(--error)';
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        document.getElementById('toast-icon').textContent = success ? '\u2705' : '\u274C';
        document.getElementById('toast-title').textContent = title;
        document.getElementById('toast-detail').textContent = detail;

        clearTimeout(window._toastTimer);
        window._toastTimer = setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-10px)';
            setTimeout(() => { toast.style.display = 'none'; }, 300);
        }, 5000);
    }

    // Handle test complete
    window.onTestComplete = function(result) {
        const log = document.getElementById('progress-log');
        const allPassed = result.allPassed;
        log.innerHTML += `<div class="log-entry" style="color: ${allPassed ? 'var(--success)' : 'var(--error)'}">
            ═══ Suite Complete: ${result.totalPassed}/${result.totalSteps} passed ═══
        </div>`;
        log.scrollTop = log.scrollHeight;

        showConnToast(allPassed,
            allPassed ? 'ALL TESTS PASSED' : 'TESTS FAILED',
            `${result.totalPassed}/${result.totalSteps} passed`);

        if (confirm(`Test complete: ${result.totalPassed}/${result.totalSteps} passed.\n\nExport results?`)) {
            exportResults('csv');
        }
    };

    // Export results
    function exportResults(format) {
        window.location.href = `/api/vsm/export/${format}`;
    }

    // Print report
    function printReport() {
        window.open('/api/vsm/report/print', '_blank');
    }

    // Clear log
    function clearLog() {
        document.getElementById('progress-log').innerHTML = '<div class="log-entry">[Cleared]</div>';
    }

    // Update UI on status change
// ReSharper disable once Html.EventNotResolved
    window.addEventListener('vsmStatusChanged', (e) => {
        const status = e.detail;
        const statusText = document.getElementById('conn-status-text');
        const portText = document.getElementById('conn-port-text');

        if (statusText) {
            statusText.textContent = status.isConnected ? '● Connected' : '○ Disconnected';
            statusText.style.color = status.isConnected ? 'var(--success)' : 'var(--error)';
        }
        if (portText) {
            portText.textContent = status.connectedPort || '—';
        }
    });

    // Refresh ports
    async function refreshPorts() {
        const ports = await fetchAvailablePorts();
        const select = document.getElementById('port-select');
        const current = select.value;
        select.innerHTML = '<option value="">Select COM Port...</option>';
        ports.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p;
            opt.textContent = p;
            if (p === current) opt.selected = true;
            select.appendChild(opt);
        });
    }
</script>
}
